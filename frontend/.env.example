# API Configuration
VITE_API_URL=https://api.betproai.com
VITE_WS_URL=wss://api.betproai.com/ws

# --- Alpha1 External API Keys (DO NOT COMMIT REAL KEYS) ---
VITE_SPORTRADAR_API_KEY=your-sportradar-key
VITE_SPORTRADAR_API_ENDPOINT=https://api.sportradar.com
VITE_WEATHER_API_KEY=your-weather-key
VITE_WEATHER_API_URL=https://api.weather.com
VITE_INJURY_API_KEY=your-injury-key
VITE_INJURY_API_URL=https://api.injurydata.com
VITE_ODDS_API_KEY=your-odds-key
VITE_ODDS_API_URL=https://api.oddsapi.com
VITE_ESPN_API_KEY=your-espn-key
VITE_ESPN_API_URL=https://api.espn.com
VITE_DAILYFANTASY_API_KEY=your-dailyfantasy-key
VITE_DAILYFANTASY_API_URL=https://api.dailyfantasy.com
VITE_SOCIAL_API_KEY=your-social-key
VITE_SOCIAL_API_URL=https://api.socialdata.com

# Authentication
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=your-auth0-audience

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_OFFLINE_MODE=false

# Performance
VITE_API_CACHE_DURATION=300000
VITE_WEBSOCKET_RECONNECT_INTERVAL=5000

# Environment
NODE_ENV=development
VITE_APP_VERSION=1.0.0
