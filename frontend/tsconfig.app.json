{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@stores/*": ["./src/stores/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": [
    "src/services/prediction/PsychologicalAnalyticsService.ts",
    "src/services/prediction/RealityExploitationService.ts",
    "src/services/prediction/SocialDynamicsService.ts",
    "src/services/prediction/TechnologicalAnalyticsService.ts",
    "src/services/prediction/PerformanceAnalyticsService.ts",
    "src/services/prediction/PredictionIntegrationService.ts",
    "src/services/ml/ensemble/EnsemblePredictor.ts"
  ]
}
